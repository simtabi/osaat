# Generated build output. build/ keeps its tracked inputs (targets.txt, and
# nfpm.yaml if one is added); everything else in it is generated, one folder
# per OS (see Makefile). /bin/ and /dist/ are the pre-src/ layout's output
# directories, kept ignored so an old local build is never committed.
/build/*
!/build/targets.txt
!/build/nfpm.yaml
# GoReleaser's scratch dist (src/.goreleaser.yaml `dist:`).
/.cache/
/bin/
/dist/
*.exe
*.test
*.out
coverage.*
*.cover
profile.out

# Go workspace + vendor
/vendor/
go.work
go.work.sum

# Local environment overrides
.env
.env.local
.envrc

# macOS
.DS_Store

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code per-user state
.claude/settings.local.json
.claude/.session/
.claude/cache/

# Tool output — these are user data, never committed (any depth so test
# runs invoked from a subdirectory don't leave stray output behind)
out/
osaat-out/
audit-*/

# Secrets — never committed even if accidentally generated in-repo
secrets.json
*.age
*.tar.age

# Local goreleaser snapshot output (older GoReleaser default)
.goreleaser/

# Test fixtures with personally-identifying data
/testdata/local/
